---
import type { Result } from '../data/types';
import { Image } from 'astro:assets';

interface Props {
  result: Result;
  label: string;
  beforeLabel: string;
  afterLabel: string;
}

const { result, label, beforeLabel, afterLabel } = Astro.props;
const imageProps = {
  widths: [400, 800],
  sizes: '(min-width: 48rem) 40vw, 100vw',
  class: 'aspect-[4/5] w-full object-cover',
};
---

<!-- Sin JS: las dos fotos lado a lado. Con JS: comparador. Solo se arrastra desde
     la línea o el círculo del centro (el resto de la foto deja pasar el scroll en
     móvil); el <input type="range"> queda para el teclado y los lectores. -->
<div
  data-compare
  class="group/compare relative grid grid-cols-2 gap-1 outline-offset-4 outline-signal data-enhanced:block data-enhanced:gap-0 has-[[data-compare-range]:focus-visible]:outline-2"
>
  <figure class="relative">
    <Image src={result.before} alt={result.alt.before} {...imageProps} />
    <figcaption class="stretch-label absolute top-3 left-3 bg-steel-950 px-2 py-1 text-label font-semibold uppercase">
      {beforeLabel}
    </figcaption>
  </figure>
  <figure
    data-compare-after
    class="relative group-data-enhanced/compare:absolute group-data-enhanced/compare:inset-0 group-data-enhanced/compare:[clip-path:inset(0_0_0_var(--pos,50%))]"
  >
    <Image src={result.after} alt={result.alt.after} {...imageProps} />
    <figcaption class="stretch-label absolute top-3 right-3 bg-steel-950 px-2 py-1 text-label font-semibold uppercase">
      {afterLabel}
    </figcaption>
  </figure>
  <div
    aria-hidden="true"
    data-compare-handle
    class="absolute inset-y-0 left-[var(--pos,50%)] z-10 hidden w-6 -translate-x-1/2 cursor-ew-resize touch-none group-data-enhanced/compare:block"
  >
    <span class="pointer-events-none absolute inset-y-0 left-1/2 w-1 -translate-x-1/2 bg-chalk"></span>
    <span class="absolute top-1/2 left-1/2 flex size-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-chalk text-steel-950 transition-[scale] duration-fast ease-out-expo group-data-dragging/compare:scale-110">
      <svg
        viewBox="0 0 24 24"
        class="size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="square"
      >
        <path d="M9 6l-6 6 6 6M15 6l6 6-6 6"></path>
      </svg>
    </span>
  </div>
  <input
    type="range"
    min="0"
    max="100"
    value="50"
    hidden
    data-compare-range
    aria-label={`${label}: ${result.name}`}
    aria-valuetext={`Mostrando 50% ${beforeLabel.toLowerCase()}`}
    class="pointer-events-none absolute inset-0 h-full w-full appearance-none bg-transparent opacity-0"
  />
</div>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const roots = document.querySelectorAll<HTMLElement>('[data-compare]');

  roots.forEach((root, index) => {
    const range = root.querySelector<HTMLInputElement>('[data-compare-range]');
    if (!range) return;
    const before =
      root
        .querySelector('figure figcaption')
        ?.textContent?.trim()
        .toLowerCase() ?? 'antes';
    const update = () => {
      root.style.setProperty('--pos', `${range.value}%`);
      range.setAttribute(
        'aria-valuetext',
        `Mostrando ${range.value}% ${before}`,
      );
    };
    range.hidden = false;
    root.toggleAttribute('data-enhanced', true);
    range.addEventListener('input', update);
    update();

    // Arrastre solo desde el centro (línea o círculo), con Pointer Events.
    const handle = root.querySelector<HTMLElement>('[data-compare-handle]');
    const moveTo = (clientX: number) => {
      const rect = root.getBoundingClientRect();
      const value = Math.round(((clientX - rect.left) / rect.width) * 100);
      range.value = String(Math.min(100, Math.max(0, value)));
      update();
    };
    handle?.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      handle.setPointerCapture(event.pointerId);
      root.toggleAttribute('data-dragging', true);
      range.dispatchEvent(new Event('pointerdown'));
    });
    handle?.addEventListener('pointermove', (event) => {
      if (handle.hasPointerCapture(event.pointerId)) moveTo(event.clientX);
    });
    const release = (event: PointerEvent) => {
      if (handle?.hasPointerCapture(event.pointerId)) {
        handle.releasePointerCapture(event.pointerId);
      }
      root.removeAttribute('data-dragging');
    };
    handle?.addEventListener('pointerup', release);
    handle?.addEventListener('pointercancel', release);

    // La primera vez que se ve, el corte hace un vaivén para mostrar que se
    // puede arrastrar. Solo mueve la imagen: el valor del control no cambia.
    if (reduceMotion || !('IntersectionObserver' in window)) return;
    let nudge: Animation | undefined;
    let touched = false;
    const stop = () => {
      touched = true;
      nudge?.cancel();
    };
    range.addEventListener('pointerdown', stop, { once: true });
    range.addEventListener('keydown', stop, { once: true });
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        if (touched) return;
        const at = `${range.value}%`;
        nudge = root.animate(
          [
            { '--pos': at },
            { '--pos': '64%' },
            { '--pos': '38%' },
            { '--pos': at },
          ],
          {
            duration: 1600,
            delay: 250 + index * 200,
            easing: 'cubic-bezier(0.77, 0, 0.175, 1)',
          },
        );
      },
      { threshold: 0.6 },
    );
    observer.observe(root);
  });
</script>
