---
import type { Testimonial } from '../../data/types';
import Athlete from '../ui/Athlete.astro';
import { Image } from 'astro:assets';
import DemoNote from '../ui/DemoNote.astro';
import GoogleLogo from '../ui/GoogleLogo.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading, { type HeadingMark } from '../ui/SectionHeading.astro';
import SteelBar from '../ui/SteelBar.astro';

interface Props {
  title: string;
  mark?: HeadingMark;
  swipeHint: string;
  demo?: string;
  testimonials: Testimonial[];
}

const { title, mark, swipeHint, demo, testimonials } = Astro.props;
---

{testimonials.length > 0 && (
  <section
    id="testimonios"
    aria-labelledby="testimonios-title"
    class="py-section"
  >
    <div class="relative mx-auto w-full max-w-content px-gutter">
      <SectionHeading
        id="testimonios-title"
        title={title}
        mark={mark}
        class="md:pr-48"
      />
      {demo && <DemoNote text={demo} class="mt-5 max-w-prose" />}
      <!-- Fondos en paralelas. Móvil: junto a «Desliza». Escritorio: arriba a
           la derecha, fuera del carrusel. -->
      <div class="mt-3 flex items-end justify-between gap-4 md:block">
        <p
          class="flex items-center gap-2 text-label text-concrete-400 uppercase md:hidden"
          aria-hidden="true"
        >
          {swipeHint}
          <Icon name="arrow" class="size-4" />
        </p>
        <Athlete
          exercise="dips"
          class="h-28 w-auto shrink-0 md:absolute md:-top-12 md:right-gutter md:h-48"
        />
      </div>
    </div>
    <ul
      class="rise mx-auto mt-10 flex max-w-content snap-x snap-mandatory scroll-px-gutter gap-4 overflow-x-auto overscroll-x-contain px-gutter pb-4 md:grid md:grid-cols-3 md:overflow-visible"
      tabindex="0"
      aria-label={title}
    >
      {testimonials.map((item) => (
        <li class="w-[85%] shrink-0 snap-start md:w-auto">
          <figure class="relative flex h-full flex-col border-t-[6px] border-transparent bg-steel-900 p-6">
            <SteelBar />
            <blockquote class="text-lede">
              <p>“{item.quote}”</p>
            </blockquote>
            <figcaption class="mt-auto flex items-center gap-3 pt-6">
              {item.photo && (
                <Image
                  src={item.photo}
                  alt=""
                  width={48}
                  height={48}
                  class="size-12 rounded-full object-cover"
                />
              )}
              <span>
                <span class="block font-bold">{item.name}</span>
                {item.achievement && (
                  <span class="block text-label text-concrete-400 uppercase">
                    {item.achievement}
                  </span>
                )}
                {item.source && (
                  <span class="mt-1 flex items-center gap-2 text-label text-concrete-400">
                    {item.platform === 'google' && (
                      <GoogleLogo class="size-6" />
                    )}
                    {item.source}
                  </span>
                )}
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>
)}
