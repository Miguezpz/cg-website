---
import type { FaqItem } from '../../data/types';
import ChalkMark from '../ui/ChalkMark.astro';
import SectionHeading, { type HeadingMark } from '../ui/SectionHeading.astro';

interface Props {
  title: string;
  mark?: HeadingMark;
  items: FaqItem[];
}

const { title, mark, items } = Astro.props;
---

<section
  id="faq"
  aria-labelledby="faq-title"
  class="grain bg-concrete-100 py-section text-steel-950"
>
  <div class="mx-auto grid w-full max-w-content gap-10 px-gutter lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1fr)] lg:gap-16">
    <SectionHeading id="faq-title" title={title} mark={mark} />
    <div class="border-t border-steel-950">
      {items.map((item) => (
        <details class="faq-item rise group border-b border-steel-950">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 [&::-webkit-details-marker]:hidden">
            <span class="stretch-heading relative text-h3 leading-tight font-bold">
              {item.q}
              <ChalkMark
                variant="underline"
                class="chalk-on-show pointer-events-none absolute -bottom-2 left-0 hidden h-2.5 w-full max-w-48 group-open:block"
              />
            </span>
            <span
              class="relative size-5 shrink-0 before:absolute before:top-1/2 before:left-0 before:h-0.5 before:w-full before:-translate-y-1/2 before:bg-steel-950 after:absolute after:top-0 after:left-1/2 after:h-full after:w-0.5 after:-translate-x-1/2 after:bg-steel-950 after:transition-transform after:duration-fast group-open:after:scale-y-0"
              aria-hidden="true"
            />
          </summary>
          <p class="faq-answer max-w-prose pb-6 text-concrete-600">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
