---
// Ruta de skills (DESIGN.md · Ruta de skills): cada skill lo hace una figura
// de gis, todas a la misma escala. Los de posición llegan a ella y se quedan;
// los de repeticiones van en bucle. Las pestañas son radios nativos + :has(),
// así que funciona sin JS (sin :has() se ven todos los skills). Sin JS o con
// movimiento reducido, la figura se queda en su pose fija.
import type { Skill } from '../../data/types';
import Button from '../ui/Button.astro';
import ChalkShapes from '../ui/ChalkShapes.astro';
import FigureChalkFilter from '../ui/FigureChalkFilter.astro';
import SectionHeading, { type HeadingMark } from '../ui/SectionHeading.astro';
import SteelBar from '../ui/SteelBar.astro';
import { skillMotions } from '../../lib/skill-poses';
import { waAttrs } from '../../lib/whatsapp';

interface Props {
  title: string;
  mark?: HeadingMark;
  intro: string;
  legend: string;
  skills: Skill[];
}

const { title, mark, intro, legend, skills } = Astro.props;
---

<section
  id="skills"
  aria-labelledby="skills-title"
  class="relative border-t-[6px] border-transparent py-section"
  data-skills
>
  <SteelBar />
  <div class="mx-auto w-full max-w-content px-gutter">
    <SectionHeading id="skills-title" title={title} mark={mark} />
    <p class="mt-4 max-w-prose text-concrete-400">{intro}</p>

    <fieldset class="mt-8">
      <legend class="sr-only">{legend}</legend>
      <div class="flex flex-wrap gap-2">
        {skills.map((skill, i) => (
          <label class="skill-tab inline-flex min-h-11 cursor-pointer items-center border-2 border-steel-700 px-4 text-label font-semibold uppercase outline-offset-4 outline-signal-glow transition-[background-color,border-color,color] duration-fast ease-out-expo has-[:checked]:border-chalk has-[:checked]:bg-chalk has-[:checked]:text-steel-950 has-[:focus-visible]:outline-2">
            <input
              type="radio"
              name="skill"
              value={skill.id}
              checked={i === 0}
              class="sr-only"
            />
            {skill.name}
          </label>
        ))}
      </div>
    </fieldset>

    {skills.map((skill) => {
      const motion = skillMotions[skill.id];
      const [, , width, height] = motion.viewBox.split(' ');
      return (
        <div class="skill-panel mt-10" data-skill={skill.id}>
          <h3 class="sr-only">{skill.name}</h3>
          <!-- En el piso, la figura se apoya en un escalón de acero. -->
          <div class="max-w-xl">
            <svg
              viewBox={motion.viewBox}
              preserveAspectRatio="xMidYMax meet"
              aria-hidden="true"
              focusable="false"
              class="skill-figure mx-auto block"
              style={`--w: ${width}; --h: ${height}`}
            >
              <defs>
                <FigureChalkFilter
                  id={`skill-chalk-${skill.id}`}
                  viewBox={motion.viewBox}
                />
              </defs>
              <g
                class="text-steel-700"
                stroke="currentColor"
                fill="currentColor"
                stroke-linecap="round"
              >
                <ChalkShapes shapes={motion.fixed} />
              </g>
              <g
                class="text-chalk"
                opacity="0.8"
                stroke="currentColor"
                fill="currentColor"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round"
                filter={`url(#skill-chalk-${skill.id})`}
                data-body
              >
                <ChalkShapes
                  shapes={motion.pose(1)}
                  gapClass="stroke-steel-950"
                  body
                />
              </g>
            </svg>
            {motion.floor && (
              <span class="block h-1.5 bg-steel-700" aria-hidden="true" />
            )}
          </div>
          <Button
            variant="secondary"
            size="sm"
            icon="whatsapp"
            class="mt-10"
            {...waAttrs({
              service: {
                id: `skill-${skill.id}`,
                waInterest: skill.waInterest,
              },
              source: 'skills',
            })}
          >
            {skill.cta}
          </Button>
        </div>
      );
    })}
  </div>
</section>

<style>
  /* Misma escala para todas las figuras (unidades del dibujo → rem): un
     cuerpo mide lo mismo en cualquier skill. Si no cabe, se reduce. */
  .skill-figure {
    --u: 0.09rem;
    width: calc(var(--w) * var(--u));
    max-width: 100%;
    height: auto;
    aspect-ratio: var(--w) / var(--h);
  }
  @media (min-width: 64rem) {
    .skill-figure {
      --u: 0.1rem;
    }
  }

  @media (any-hover: hover) and (pointer: fine) {
    .skill-tab:not(:has(:checked)):hover {
      border-color: var(--color-concrete-400);
    }
  }

  /* Solo se ve el skill elegido. */
  @supports selector(:has(*)) {
    .skill-panel {
      display: none;
    }
    [data-skills]:has([value='handstand']:checked) [data-skill='handstand'],
    [data-skills]:has([value='muscleup']:checked) [data-skill='muscleup'],
    [data-skills]:has([value='frontlever']:checked) [data-skill='frontlever'],
    [data-skills]:has([value='planche']:checked) [data-skill='planche'],
    [data-skills]:has([value='backlever']:checked) [data-skill='backlever'],
    [data-skills]:has([value='pistol']:checked) [data-skill='pistol'] {
      display: block;
    }
  }
</style>

<script>
  import { track } from '../../lib/analytics';
  import { update } from '../../lib/athletes';
  import { skillMotions, type SkillId } from '../../lib/skill-poses';

  /** Pausa en la posición inicial antes de repetir, en ms. */
  const REST = 600;

  const section = document.querySelector<HTMLElement>('[data-skills]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const animate = !!section && !reduce && 'IntersectionObserver' in window;
  let frame = 0;
  let playing: HTMLElement | undefined;
  /** Skills de posición que ya llegaron a ella: se quedan quietos. */
  const done = new Set<HTMLElement>();

  const panels = [
    ...(section?.querySelectorAll<HTMLElement>('[data-skill]') ?? []),
  ];
  const motionOf = (panel: HTMLElement) =>
    skillMotions[panel.dataset.skill as SkillId];
  const partsOf = (panel: HTMLElement) =>
    panel.querySelector('[data-body]')?.children;
  const isCurrent = (panel: HTMLElement) =>
    !!section
      ?.querySelector(`[name="skill"][value="${panel.dataset.skill}"]`)
      ?.matches(':checked');

  /** Avance 0 → 1 → 0 en el instante `t` del ciclo: ida, vuelta y pausa. */
  function progress(t: number, duration: number): number {
    const at = t % (2 * duration + REST);
    if (at < duration) return at / duration;
    return Math.max(0, 2 - at / duration);
  }

  function stop(): void {
    cancelAnimationFrame(frame);
    playing = undefined;
  }

  /**
   * Un skill de posición va del inicio a la posición y se queda. Uno de
   * repeticiones se repite mientras se ve; empieza por la vuelta, así que
   * arranca desde la pose fija sin saltos.
   */
  function play(panel: HTMLElement): void {
    const motion = motionOf(panel);
    const parts = partsOf(panel);
    if (playing === panel || !motion || !parts) return;
    if (motion.play === 'hold' && done.has(panel)) return;
    stop();
    playing = panel;
    const reps = motion.play === 'reps';
    let start = 0;
    const tick = (now: number) => {
      start ||= reps ? now - motion.duration : now;
      const t = now - start;
      if (reps) {
        update(parts, motion.pose(progress(t, motion.duration)));
      } else {
        const p = Math.min(1, t / motion.duration);
        update(parts, motion.pose(p));
        if (p === 1) {
          done.add(panel);
          playing = undefined;
          return;
        }
      }
      frame = requestAnimationFrame(tick);
    };
    frame = requestAnimationFrame(tick);
  }

  if (animate) {
    // Los de posición esperan en su inicio, fuera de pantalla.
    for (const panel of panels) {
      const motion = motionOf(panel);
      if (motion?.play === 'hold') update(partsOf(panel), motion.pose(0));
    }
    // Solo se ve el skill elegido: al cambiar de pestaña, su figura aparece
    // (y la otra desaparece) y el observador se entera.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const panel = entry.target.closest<HTMLElement>('[data-skill]');
          if (!panel) continue;
          if (entry.isIntersecting && isCurrent(panel)) play(panel);
          else if (panel === playing) stop();
        }
      },
      { threshold: 0.5 },
    );
    panels.forEach((panel) => {
      const figure = panel.querySelector('.skill-figure');
      if (figure) observer.observe(figure);
    });
  }

  section?.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement;
    if (input.name !== 'skill') return;
    track('skill_view', { skill: input.value });
    // Al volver a elegirlo, el skill de posición se ejecuta otra vez.
    const panel = panels.find((p) => p.dataset.skill === input.value);
    const motion = panel && motionOf(panel);
    if (!animate || !panel || motion?.play !== 'hold') return;
    done.delete(panel);
    update(partsOf(panel), motion.pose(0));
  });
</script>
