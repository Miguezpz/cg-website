---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import ChalkMark from '../ui/ChalkMark.astro';
import Icon from '../ui/Icon.astro';
import { waAttrs } from '../../lib/whatsapp';

interface Props {
  title: string;
  lede: string;
  where: string;
  primaryCta: string;
  secondaryCta: { label: string; href: string };
  onlineLink: { question: string; label: string; href: string };
  indicators: readonly { value: string; label: string }[];
  image: ImageMetadata;
  imageAlt: string;
}

const {
  title,
  lede,
  where,
  primaryCta,
  secondaryCta,
  onlineLink,
  indicators,
  image,
  imageAlt,
} = Astro.props;
---

<section
  aria-labelledby="hero-title"
  class="relative -mt-16 pt-16 pb-12 lg:pb-20"
>
  <div class="mx-auto w-full max-w-content px-gutter">
    <!-- La barra: cruza la pantalla y sostiene la foto. -->
    <div class="relative mt-6 lg:mt-12">
      <div
        class="relative left-1/2 h-1.5 w-screen -translate-x-1/2 bg-steel-700"
        aria-hidden="true"
      ></div>
      <ChalkMark
        variant="hands"
        class="absolute -top-3 left-1/2 z-10 h-7 w-72 -translate-x-1/2 text-chalk lg:right-0 lg:left-auto lg:w-[26rem] lg:translate-x-0"
      />
    </div>

    <!-- Móvil: texto → foto → indicadores. Escritorio: texto e indicadores a la izquierda, foto a la derecha. -->
    <div class="grid gap-x-16 gap-y-8 pt-6 lg:grid-cols-[minmax(0,1fr)_26rem] lg:grid-rows-[auto_1fr] lg:pt-0">
      <div class="lg:pt-14">
        <h1
          id="hero-title"
          class="stretch-display text-display font-black uppercase"
        >
          {title}
        </h1>
        <p class="mt-4 max-w-[22ch] text-lede text-chalk">{lede}</p>
        <p class="stretch-label mt-2 text-label font-semibold text-concrete-400 uppercase">
          {where}
        </p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button icon="whatsapp" {...waAttrs({ source: 'hero' })}>
            {primaryCta}
          </Button>
          <Button variant="secondary" href={secondaryCta.href}>
            {secondaryCta.label}
          </Button>
        </div>
        <a
          href={onlineLink.href}
          class="group mt-3 inline-block py-2.5 text-concrete-400 transition-colors duration-fast hover:text-chalk"
        >
          {onlineLink.question}{' '}
          <span class="font-semibold whitespace-nowrap text-chalk underline">
            {onlineLink.label}
            <Icon
              name="arrow"
              class="ml-1 inline size-4 align-[-0.15em] transition-transform duration-fast group-hover:translate-x-0.5"
            />
          </span>
        </a>
      </div>

      <figure class="relative -mx-gutter border-steel-700 sm:mx-0 self-start sm:border-x-2 sm:border-b-2 lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <Picture
          src={image}
          alt={imageAlt}
          formats={['avif', 'webp']}
          widths={[480, 768, 1024, 1600]}
          sizes="(min-width: 64rem) 26rem, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full object-cover"
        />
      </figure>

      <ul class="flex flex-wrap gap-x-6 gap-y-3 self-start border-t border-steel-700 pt-5 lg:col-start-1 lg:row-start-2">
        {indicators.map((item) => (
          <li class="stretch-label text-label uppercase">
            <span class="font-bold text-chalk">{item.value}</span>{' '}
            <span class="text-concrete-400">{item.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
