---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import ChalkMark from '../ui/ChalkMark.astro';
import ChalkNote from '../ui/ChalkNote.astro';
import DemoNote from '../ui/DemoNote.astro';
import Icon from '../ui/Icon.astro';
import { waAttrs } from '../../lib/whatsapp';

interface Props {
  title: string;
  /** Palabra del título en vino claro. */
  accent?: string;
  lede: string;
  where: string;
  primaryCta: string;
  note: string;
  secondaryCta: { label: string; href: string };
  onlineLink: { question: string; label: string; href: string };
  indicators: readonly { value: string; label: string }[];
  image: ImageMetadata;
  imageAlt: string;
  /** Punto focal del recorte 4:5 (`object-position`). */
  imagePosition?: string;
  imageDemo?: string;
}

const {
  title,
  accent,
  lede,
  where,
  primaryCta,
  note,
  secondaryCta,
  onlineLink,
  indicators,
  image,
  imageAlt,
  imagePosition = '50% 50%',
  imageDemo,
} = Astro.props;

// El título con su palabra clave en vino claro (DESIGN.md · Color).
const at = accent ? title.toLowerCase().indexOf(accent.toLowerCase()) : -1;
const titleParts =
  at >= 0
    ? [
        title.slice(0, at),
        title.slice(at, at + accent!.length),
        title.slice(at + accent!.length),
      ]
    : undefined;

// Partículas de magnesia que se sueltan de las marcas de agarre al cargar
// (decorativas; posiciones fijas para que el HTML sea estable entre builds).
const dust = Array.from({ length: 14 }, (_, i) => {
  const rand = (n: number) =>
    (((Math.sin(i * 12.9898 + n * 78.233) * 43758.5453) % 1) + 1) % 1;
  const left = i % 2 === 0 ? 20 + rand(1) * 16 : 63 + rand(1) * 17;
  const size = (2 + rand(4) * 2.5).toFixed(1);
  return [
    `left:${left.toFixed(1)}%`,
    `width:${size}px`,
    `height:${size}px`,
    `--dx:${((rand(2) - 0.5) * 48).toFixed(0)}px`,
    `--dy:${(40 + rand(3) * 60).toFixed(0)}px`,
    `--d:${(560 + rand(5) * 380).toFixed(0)}ms`,
  ].join(';');
});
---

<section
  aria-labelledby="hero-title"
  class="relative -mt-16 overflow-x-clip pt-16 pb-12 lg:pb-20"
>
  <div class="mx-auto w-full max-w-content px-gutter">
    <!-- La barra: cruza la pantalla y sostiene la foto. -->
    <div class="relative mt-6 lg:mt-12">
      <div
        class="hero-bar relative left-1/2 h-1.5 w-screen -translate-x-1/2 bg-steel-700"
        aria-hidden="true"
      ></div>
      <div class="absolute -top-3 left-1/2 z-10 h-7 w-72 -translate-x-1/2 lg:right-0 lg:left-auto lg:w-[26rem] lg:translate-x-0">
        <ChalkMark
          variant="hands"
          class="hero-grips h-full w-full text-chalk"
        />
        <div class="hero-dust" aria-hidden="true">
          {dust.map((style) => (
            <span
              class="absolute top-1/2 rounded-full bg-chalk opacity-0"
              style={style}
            />
          ))}
        </div>
      </div>
    </div>

    <!-- Móvil: texto → foto → indicadores. Escritorio: texto e indicadores a la izquierda, foto a la derecha. -->
    <div class="grid gap-x-16 gap-y-8 pt-6 lg:grid-cols-[minmax(0,1fr)_26rem] lg:grid-rows-[auto_1fr] lg:pt-0">
      <div class="lg:pt-14">
        <h1 id="hero-title" class="hero-lift text-display font-bold uppercase">
          {titleParts ? (
            <>
              {titleParts[0]}
              <span class="text-signal-glow" data-accent>
                {titleParts[1]}
              </span>
              {titleParts[2]}
            </>
          ) : (
            title
          )}
        </h1>
        <p
          class="hero-rise mt-4 max-w-[22ch] text-lede text-chalk"
          style="--d:180ms"
        >
          {lede}
        </p>
        <p
          class="hero-rise mt-2 text-label font-semibold text-concrete-400 uppercase"
          style="--d:240ms"
        >
          {where}
        </p>

        <div
          class="hero-rise mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap"
          style="--d:300ms"
        >
          <Button icon="whatsapp" {...waAttrs({ source: 'hero' })}>
            {primaryCta}
          </Button>
          <Button variant="secondary" href={secondaryCta.href}>
            {secondaryCta.label}
          </Button>
        </div>
        <ChalkNote
          text={note}
          arrow="up"
          class="mt-1 ml-10 hidden [--chalk-delay:900ms] lg:flex"
        />
        <a
          href={onlineLink.href}
          class="hero-rise group mt-3 inline-block py-2.5 text-concrete-400 transition-colors duration-fast hover:text-chalk"
          style="--d:360ms"
        >
          {onlineLink.question}{' '}
          <span class="font-semibold whitespace-nowrap text-chalk underline">
            {onlineLink.label}
            <Icon
              name="arrow"
              class="ml-1 inline size-4 align-[-0.15em] transition-transform duration-fast group-hover:translate-x-0.5"
            />
          </span>
        </a>
      </div>

      <figure class="hero-hang relative -mx-gutter self-start overflow-hidden border-steel-700 shadow-depth sm:mx-0 sm:border-x-2 sm:border-b-2 lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <Picture
          src={image}
          alt={imageAlt}
          formats={['avif', 'webp']}
          widths={[480, 768, 1024, 1600]}
          sizes="(min-width: 64rem) 26rem, 100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-parallax aspect-[4/5] w-full object-cover"
          style={`object-position: ${imagePosition}`}
        />
        {/* Arriba, para no tapar las manos en la barra. */}
        {imageDemo && (
          <DemoNote text={imageDemo} class="absolute top-3 right-3 left-3" />
        )}
      </figure>

      <ul
        class="hero-rise flex flex-wrap gap-x-6 gap-y-3 self-start border-t border-steel-700 pt-5 lg:col-start-1 lg:row-start-2"
        style="--d:420ms"
      >
        {indicators.map((item) => (
          <li class="text-label uppercase">
            <span class="font-bold text-chalk">{item.value}</span>{' '}
            <span class="text-concrete-400">{item.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { initHeroPhysics } from '../../lib/hero-physics';
  initHeroPhysics();
</script>
