---
import type { Service } from '../../data/types';
import Athlete from '../ui/Athlete.astro';
import Button from '../ui/Button.astro';
import ChalkNote from '../ui/ChalkNote.astro';
import DemoNote from '../ui/DemoNote.astro';
import SectionHeading, { type HeadingMark } from '../ui/SectionHeading.astro';
import SteelBar from '../ui/SteelBar.astro';
import { waAttrs } from '../../lib/whatsapp';

interface Props {
  title: string;
  mark?: HeadingMark;
  intro: string;
  /** Puerta a algo más a la medida que la rutina: solo se pide por WhatsApp. */
  custom: { title: string; text: string; cta: string; waInterest: string };
  services: Service[];
}

const { title, mark, intro, custom, services } = Astro.props;
---

<section id="servicios" aria-labelledby="servicios-title" class="py-section">
  <div class="relative mx-auto w-full max-w-content px-gutter">
    <SectionHeading id="servicios-title" title={title} mark={mark} />
    <!-- Móvil: el atleta junto a la entrada. Escritorio: cuelga arriba a la derecha. -->
    <div class="mt-4 flex items-start gap-4 md:block">
      <p class="max-w-prose flex-1 text-concrete-400 md:pr-40">{intro}</p>
      <Athlete
        exercise="pullup"
        class="-mt-1 h-40 w-auto shrink-0 md:absolute md:-top-12 md:right-gutter md:mt-0 md:h-56"
      />
    </div>

    <div class="mt-12 space-y-16 lg:space-y-20">
      {services.map((service, i) => (
        <article
          aria-labelledby={`servicio-${service.id}`}
          class="relative grid gap-8 border-t-[6px] border-transparent pt-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16"
        >
          <SteelBar />
          <div>
            <h3
              id={`servicio-${service.id}`}
              class="ledge text-[1.875rem] leading-none font-bold tracking-[-0.02em] uppercase lg:text-[2.75rem]"
            >
              {service.name}
            </h3>
            <p class="mt-4 max-w-prose text-lede">{service.audience}</p>
            <ul class="rise mt-6 space-y-3">
              {service.includes.map((item) => (
                <li class="flex gap-3 text-concrete-400">
                  <span
                    class="mt-[0.7em] h-0.5 w-4 shrink-0 bg-chalk"
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {service.demo && <DemoNote text={service.demo} class="mt-6" />}
          </div>

          <div class="flex flex-col lg:items-start lg:pt-2">
            <Button
              icon="whatsapp"
              class="self-start"
              {...waAttrs({ service, source: 'services' })}
            >
              {service.cta}
            </Button>
            {service.note && (
              <ChalkNote
                text={service.note}
                arrow="up"
                class="mt-1 ml-10 [--chalk-delay:200ms]"
              />
            )}
            {/* Después del último servicio: la puerta a algo más a la medida. */}
            {i === services.length - 1 && (
              <aside
                id="a-medida"
                aria-labelledby="a-medida-title"
                class="rise mt-10 border border-steel-700 bg-steel-900 p-6 sm:p-8 lg:mt-auto"
              >
                <h3 id="a-medida-title" class="text-h3 font-bold">
                  {custom.title}
                </h3>
                <p class="mt-3 max-w-prose text-concrete-400">{custom.text}</p>
                <Button
                  variant="secondary"
                  size="sm"
                  icon="whatsapp"
                  class="mt-6"
                  {...waAttrs({
                    service: { id: 'a-medida', waInterest: custom.waInterest },
                    source: 'services',
                  })}
                >
                  {custom.cta}
                </Button>
              </aside>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
