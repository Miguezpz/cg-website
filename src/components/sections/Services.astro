---
import type { Service } from '../../data/types';
import Button from '../ui/Button.astro';
import ChalkMark from '../ui/ChalkMark.astro';
import ChalkNote from '../ui/ChalkNote.astro';
import DemoNote from '../ui/DemoNote.astro';
import SectionHeading, { type HeadingMark } from '../ui/SectionHeading.astro';
import SteelBar from '../ui/SteelBar.astro';
import { waAttrs } from '../../lib/whatsapp';

interface Props {
  title: string;
  mark?: HeadingMark;
  intro: string;
  services: Service[];
}

const { title, mark, intro, services } = Astro.props;
---

<section id="servicios" aria-labelledby="servicios-title" class="py-section">
  <div class="mx-auto w-full max-w-content px-gutter">
    <SectionHeading id="servicios-title" title={title} mark={mark} />
    <p class="mt-4 max-w-prose text-concrete-400">{intro}</p>

    <div class="mt-12 space-y-16 lg:space-y-20">
      {services.map((service) => (
        <article
          aria-labelledby={`servicio-${service.id}`}
          class="relative grid gap-8 border-t-[6px] border-transparent pt-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16"
        >
          <SteelBar />
          <div>
            <h3
              id={`servicio-${service.id}`}
              class="ledge text-[1.875rem] leading-none font-bold tracking-[-0.02em] uppercase lg:text-[2.75rem]"
            >
              {service.name}
            </h3>
            <p class="mt-4 max-w-prose text-lede">{service.audience}</p>
            <ul class="rise mt-6 space-y-3">
              {service.includes.map((item) => (
                <li class="flex gap-3 text-concrete-400">
                  <span
                    class="mt-[0.7em] h-0.5 w-4 shrink-0 bg-chalk"
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {service.demo && <DemoNote text={service.demo} class="mt-6" />}
          </div>

          <div class="flex flex-col">
            {service.plans.length > 0 && (
              <dl class="border-t border-steel-700">
                {service.plans.map((plan) => (
                  <div class="rise grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-4 border-b border-steel-700 py-4">
                    <dt>
                      <span class="block text-h3 font-bold">{plan.name}</span>
                      <span class="mt-1 block text-label text-concrete-400 uppercase">
                        {plan.detail}
                      </span>
                      {plan.perWeek && (
                        <ChalkMark
                          variant="tally"
                          count={plan.perWeek}
                          draw
                          class="mt-2 h-7 w-auto text-chalk [--chalk-delay:200ms]"
                        />
                      )}
                    </dt>
                    <dd class="text-[2.5rem] leading-none font-bold tabular-nums">
                      {plan.price}
                    </dd>
                  </div>
                ))}
              </dl>
            )}
            {service.note && (
              <ChalkNote text={service.note} arrow="up" class="mt-2 self-end" />
            )}
            <Button
              icon="whatsapp"
              class="mt-6 self-start"
              {...waAttrs({ service, source: 'services' })}
            >
              {service.cta}
            </Button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
