---
import type { Result } from '../../data/types';
import BeforeAfterSlider from '../BeforeAfterSlider.astro';
import DemoNote from '../ui/DemoNote.astro';
import SectionHeading, { type HeadingMark } from '../ui/SectionHeading.astro';
import SteelBar from '../ui/SteelBar.astro';

interface Props {
  title: string;
  mark?: HeadingMark;
  intro: string;
  sliderLabel: string;
  before: string;
  after: string;
  results: Result[];
}

const { title, mark, intro, sliderLabel, before, after, results } = Astro.props;
---

{results.length > 0 && (
  <section
    id="resultados"
    aria-labelledby="resultados-title"
    class="relative border-t-[6px] border-transparent py-section"
  >
    <SteelBar />
    <div class="mx-auto w-full max-w-content px-gutter">
      <SectionHeading id="resultados-title" title={title} mark={mark} />
      <p class="mt-4 max-w-prose text-concrete-400">{intro}</p>
      <ul class="mt-12 grid gap-12 md:grid-cols-2 md:gap-8">
        {results.map((result) => (
          <li class="rise">
            <BeforeAfterSlider
              result={result}
              label={sliderLabel}
              beforeLabel={before}
              afterLabel={after}
            />
            <p class="mt-5 text-h3 font-bold">{result.achievement}</p>
            <p class="mt-1 text-label text-concrete-400 uppercase">
              {result.name}
              {result.duration && ` · ${result.duration}`}
            </p>
            {result.demo && <DemoNote text={result.demo} class="mt-4" />}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
