---
import type { Result } from '../../data/types';
import BeforeAfterSlider from '../BeforeAfterSlider.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  title: string;
  intro: string;
  sliderLabel: string;
  before: string;
  after: string;
  results: Result[];
}

const { title, intro, sliderLabel, before, after, results } = Astro.props;
---

{results.length > 0 && (
  <section
    id="resultados"
    aria-labelledby="resultados-title"
    class="border-t-[6px] border-steel-700 py-section"
  >
    <div class="mx-auto w-full max-w-content px-gutter">
      <SectionHeading id="resultados-title">{title}</SectionHeading>
      <p class="mt-4 max-w-prose text-concrete-400">{intro}</p>
      <ul class="mt-12 grid gap-12 md:grid-cols-2 md:gap-8">
        {results.map((result) => (
          <li>
            <BeforeAfterSlider
              result={result}
              label={sliderLabel}
              beforeLabel={before}
              afterLabel={after}
            />
            <p class="stretch-heading mt-5 text-h3 font-bold">
              {result.achievement}
            </p>
            <p class="stretch-label mt-1 text-label text-concrete-400 uppercase">
              {result.name} · {result.duration}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
