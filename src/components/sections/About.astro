---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import DemoNote from '../ui/DemoNote.astro';
import SectionHeading, { type HeadingMark } from '../ui/SectionHeading.astro';
import { waAttrs } from '../../lib/whatsapp';
import type { CredentialGroup } from '../../lib/structured-data';

interface Props {
  title: string;
  mark?: HeadingMark;
  role: string;
  story: readonly string[];
  credentials: readonly CredentialGroup[];
  /** Franja de fotos bajo la ficha: verticales 2:3 y una horizontal 3:2. */
  gallery?: {
    caption: string;
    photos: readonly {
      src: ImageMetadata;
      alt: string;
      orientation: 'portrait' | 'landscape';
    }[];
  };
  /** Cierre de la sección: una pregunta y el CTA general de WhatsApp. */
  cta: { lead: string; label: string };
  photo: ImageMetadata;
  photoAlt: string;
  demo?: string;
}

const {
  title,
  mark,
  role,
  story,
  credentials,
  gallery,
  cta,
  photo,
  photoAlt,
  demo,
} = Astro.props;
---

<section
  id="sobre-mi"
  aria-labelledby="sobre-mi-title"
  class="on-light grain bg-concrete-100 py-section text-steel-950"
>
  <div class="mx-auto w-full max-w-content px-gutter">
    <div class="grid gap-10 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1fr)] md:items-start lg:gap-16">
      <figure class="reveal-photo relative overflow-hidden border-b-[6px] border-steel-950 md:sticky md:top-24">
        <Image
          src={photo}
          alt={photoAlt}
          widths={[360, 537]}
          sizes="(min-width: 48rem) 40vw, 100vw"
          class="parallax aspect-[537/690] w-full object-cover grayscale"
        />
      </figure>

      <div>
        <SectionHeading id="sobre-mi-title" title={title} mark={mark} />
        <p class="mt-3 text-label font-semibold text-concrete-600 uppercase">
          {role}
        </p>
        <div class="mt-6 max-w-prose space-y-4 text-lede">
          {story.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
        {demo && <DemoNote text={demo} tone="light" class="mt-5 max-w-prose" />}
        {credentials.map((group) => (
          <div class="mt-8">
            <h3 class="text-label font-semibold text-concrete-600 uppercase">
              {group.title}
            </h3>
            <ul class="mt-3 border-t border-steel-950/20">
              {group.items.map((item) => (
                <li class="rise flex gap-3 border-b border-steel-950/20 py-3">
                  <span
                    class="mt-[0.6em] h-1 w-5 shrink-0 bg-steel-950"
                    aria-hidden="true"
                  />
                  <span>
                    <span class="block text-body leading-snug font-bold text-pretty">
                      {item.text}
                    </span>
                    <span class="mt-0.5 block text-label text-concrete-600">
                      {item.detail}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    {gallery && (
      <figure class="rise mt-12 md:mt-16">
        <div class="grid grid-flow-dense grid-cols-2 gap-2 md:grid-cols-[2fr_4.5fr_2fr] md:gap-3">
          {gallery.photos.map((item) =>
            item.orientation === 'landscape' ? (
              <Image
                src={item.src}
                alt={item.alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 72rem) 38rem, (min-width: 48rem) 53vw, 100vw"
                class="col-span-2 aspect-[3/2] w-full object-cover grayscale md:col-span-1"
              />
            ) : (
              <Image
                src={item.src}
                alt={item.alt}
                widths={[240, 360, 540]}
                sizes="(min-width: 72rem) 17rem, (min-width: 48rem) 24vw, 50vw"
                class="aspect-[2/3] w-full object-cover grayscale"
              />
            ),
          )}
        </div>
        <figcaption class="mt-3 text-label font-semibold text-concrete-600 uppercase">
          {gallery.caption}
        </figcaption>
      </figure>
    )}

    <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
      <p class="text-h3 font-bold">{cta.lead}</p>
      <Button icon="whatsapp" {...waAttrs({ source: 'about' })}>
        {cta.label}
      </Button>
    </div>
  </div>
</section>
