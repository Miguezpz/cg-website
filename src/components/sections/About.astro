---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  title: string;
  role: string;
  story: readonly string[];
  credentials: readonly string[];
  photo: ImageMetadata;
  photoAlt: string;
}

const { title, role, story, credentials, photo, photoAlt } = Astro.props;
---

<section
  id="sobre-mi"
  aria-labelledby="sobre-mi-title"
  class="bg-concrete-100 py-section text-steel-950"
>
  <div class="mx-auto grid w-full max-w-content gap-10 px-gutter md:grid-cols-[minmax(0,0.8fr)_minmax(0,1fr)] md:items-end lg:gap-16">
    <figure class="reveal-photo relative overflow-hidden border-b-[6px] border-steel-950">
      <Image
        src={photo}
        alt={photoAlt}
        widths={[360, 537]}
        sizes="(min-width: 48rem) 40vw, 100vw"
        class="parallax aspect-[537/690] w-full object-cover grayscale"
      />
    </figure>

    <div>
      <SectionHeading id="sobre-mi-title">{title}</SectionHeading>
      <p class="stretch-label mt-3 text-label font-semibold text-concrete-600 uppercase">
        {role}
      </p>
      <div class="mt-6 max-w-prose space-y-4 text-lede">
        {story.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <ul class="mt-8 border-t border-steel-950/20">
        {credentials.map((item) => (
          <li class="rise stretch-heading flex gap-3 border-b border-steel-950/20 py-3 text-h3 leading-tight font-bold">
            <span
              class="mt-[0.55em] h-1 w-5 shrink-0 bg-steel-950"
              aria-hidden="true"
            />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
