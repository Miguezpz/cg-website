---
// Trazos de gis: manos sobre la barra, subrayado o marcas de conteo.
interface Props {
  variant: 'hands' | 'underline' | 'tally';
  count?: number;
  class?: string;
}
const { variant, count = 5, class: className } = Astro.props;

// Marcas de conteo agrupadas de 5 en 5 (cuatro verticales y una cruzada).
const tally = Array.from({ length: count }, (_, i) => {
  const group = Math.floor(i / 5);
  const pos = i % 5;
  const x0 = group * 70 + 8;
  if (pos === 4) return `M${x0 - 6} 46 L${x0 + 52} 12`;
  const x = x0 + pos * 12;
  return `M${x} 8 Q${x + 2} 30 ${x - 1} 52`;
});
const tallyWidth = Math.ceil(count / 5) * 70;
---

{variant === 'hands' && (
  <svg
    viewBox="0 0 400 28"
    class={className}
    aria-hidden="true"
    focusable="false"
    preserveAspectRatio="none"
  >
    <g fill="currentColor" filter="url(#chalk)">
      <path
        opacity="0.42"
        d="M70 12c18-5 58-6 82-2 9 2 9 7 0 9-25 4-62 4-82 0-8-2-8-5 0-7z"
      />
      <path
        opacity="0.38"
        d="M246 11c20-5 60-5 84-1 9 2 8 7-1 9-24 4-62 4-83 0-8-2-8-6 0-8z"
      />
    </g>
  </svg>
)}
{variant === 'underline' && (
  <svg
    viewBox="0 0 300 20"
    class={className}
    aria-hidden="true"
    focusable="false"
    preserveAspectRatio="none"
  >
    <path
      d="M4 13 C60 6 140 15 210 9 S280 8 296 11"
      pathLength="1"
      fill="none"
      stroke="currentColor"
      stroke-width="5"
      stroke-linecap="round"
      filter="url(#chalk)"
    />
  </svg>
)}
{variant === 'tally' && (
  <svg
    viewBox={`0 0 ${tallyWidth} 60`}
    class={className}
    aria-hidden="true"
    focusable="false"
  >
    <g
      fill="none"
      stroke="currentColor"
      stroke-width="5"
      stroke-linecap="round"
      filter="url(#chalk)"
    >
      {tally.map((d, i) => (
        <path d={d} pathLength="1" class="chalk-stroke" style={`--i:${i}`} />
      ))}
    </g>
  </svg>
)}
