---
// Trazos de gis. Todos son decorativos (aria-hidden) y usan el filtro #chalk.
// Todos se pueden dibujar: con `draw`, se trazan a mano al
//   entrar en pantalla (src/lib/chalk.ts); sin JS o con movimiento reducido se
//   ven completos. Con la clase `chalk-on-show`, se dibujan cada vez que pasan
//   de ocultos a visibles (motion.css).
type Variant =
  | 'underline'
  | 'double'
  | 'circle'
  | 'check'
  | 'tally'
  | 'arrow-up'
  | 'arrow-down'
  | 'arrow-left'
  | 'arrow-right';

interface Props {
  variant: Variant;
  count?: number;
  draw?: boolean;
  class?: string;
  hidden?: boolean;
  [key: `data-${string}`]: string | boolean | undefined;
}

const {
  variant,
  count = 5,
  draw = false,
  class: className,
  ...attrs
} = Astro.props;

// Marcas de conteo agrupadas de 5 en 5 (cuatro verticales y una cruzada).
const tally = Array.from({ length: count }, (_, i) => {
  const group = Math.floor(i / 5);
  const pos = i % 5;
  const x0 = group * 70 + 8;
  if (pos === 4) return `M${x0 - 6} 46 L${x0 + 52} 12`;
  const x = x0 + pos * 12;
  return `M${x} 8 Q${x + 2} 30 ${x - 1} 52`;
});

// Trazos a mano alzada: viewBox, caminos (en orden de dibujo) y si el SVG se
// estira para ocupar su caja. Sin `vector-effect: non-scaling-stroke` a
// propósito: con él, `pathLength` deja de normalizar el trazo y la línea se
// dibuja cortada cuando el SVG se estira.
const strokes: Record<
  Variant,
  { viewBox: string; paths: string[]; stretch?: boolean; width?: number }
> = {
  underline: {
    viewBox: '0 0 300 20',
    paths: ['M4 13 C60 6 140 15 210 9 S280 8 296 11'],
    stretch: true,
    width: 4.5,
  },
  double: {
    viewBox: '0 0 300 30',
    paths: ['M6 10 C80 4 200 13 294 7', 'M22 23 C100 17 212 25 286 19'],
    stretch: true,
    width: 4.5,
  },
  circle: {
    viewBox: '0 0 220 90',
    paths: [
      'M42 15 C92 1 186 5 209 36 C222 62 160 86 104 84 C44 82 6 64 12 40 C18 20 66 8 132 10',
    ],
    stretch: true,
    width: 3.5,
  },
  check: { viewBox: '0 0 40 40', paths: ['M6 22 L16 32 L35 7'], width: 4 },
  tally: { viewBox: `0 0 ${Math.ceil(count / 5) * 70} 60`, paths: tally },
  'arrow-up': {
    viewBox: '0 0 60 60',
    paths: ['M30 56 C24 42 34 26 28 9', 'M18 20 L28 7 L39 19'],
    width: 3.5,
  },
  'arrow-down': {
    viewBox: '0 0 60 60',
    paths: ['M28 4 C36 18 24 34 31 51', 'M21 41 L31 53 L41 42'],
    width: 3.5,
  },
  'arrow-left': {
    viewBox: '0 0 80 50',
    paths: ['M74 30 C56 20 34 34 10 25', 'M22 15 L8 25 L21 36'],
    width: 3.5,
  },
  'arrow-right': {
    viewBox: '0 0 80 50',
    paths: ['M6 25 C26 35 46 18 70 26', 'M58 16 L72 26 L58 36'],
    width: 3.5,
  },
};

const stroke = strokes[variant];
---

<svg
  viewBox={stroke.viewBox}
  class={className}
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio={stroke.stretch ? 'none' : undefined}
  data-chalk={draw ? '' : undefined}
  {...attrs}
>
  <g
    fill="none"
    stroke="currentColor"
    stroke-width={stroke.width ?? 5}
    stroke-linecap="round"
    stroke-linejoin="round"
    filter="url(#chalk)"
  >
    {stroke.paths.map((d, i) => (
      <path d={d} pathLength="1" class="chalk-stroke" style={`--i:${i}`} />
    ))}
  </g>
</svg>
