---
interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
  class?: string;
  [key: string]: unknown;
}
const { as: Tag = 'div', class: className, ...rest } = Astro.props;
---

<Tag
  class:list={['mx-auto w-full max-w-content px-gutter', className]}
  {...rest}
>
  <slot />
</Tag>
