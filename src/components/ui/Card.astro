---
// Superficie de acero elevada con canto de metal (DESIGN.md · Material y forma).
interface Props {
  as?: 'div' | 'article' | 'li' | 'figure';
  class?: string;
}
const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['border border-steel-700 bg-steel-900 p-6', className]}>
  <slot />
</Tag>
