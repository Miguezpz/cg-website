---
// Atleta de gis que hace un ejercicio con el scroll o una sola vez al aparecer
// (src/lib/athletes.ts).
// Decorativo: sin JS o con movimiento reducido se ve en su pose fija.
import { athletes, type Exercise } from '../../lib/athlete-poses';
import ChalkShapes from './ChalkShapes.astro';
import FigureChalkFilter from './FigureChalkFilter.astro';

interface Props {
  exercise: Exercise;
  /** Gis sobre acero; carbón sobre las secciones de concreto. */
  tone?: 'chalk' | 'charcoal';
  /** Repeticiones una sola vez al verse, no con el scroll (páginas cortas). */
  once?: boolean;
  class?: string;
}

const {
  exercise,
  tone = 'chalk',
  once = false,
  class: className,
} = Astro.props;
const rig = athletes[exercise];
const filterId = `athlete-chalk-${exercise}`;

// El «corte» que separa un brazo del torso va del color del fondo.
const gapClass = tone === 'chalk' ? 'stroke-steel-950' : 'stroke-concrete-100';
---

<svg
  viewBox={rig.viewBox}
  class={className}
  aria-hidden="true"
  focusable="false"
  data-athlete={exercise}
  data-play={once || rig.play === 'once' ? 'once' : 'scroll'}
>
  <defs>
    <FigureChalkFilter id={filterId} viewBox={rig.viewBox} />
  </defs>
  <g
    class={tone === 'chalk' ? 'text-steel-700' : 'text-concrete-600'}
    stroke="currentColor"
    fill="currentColor"
    stroke-linecap="round"
  >
    <ChalkShapes shapes={rig.fixed} />
    {rig.gear && (
      <g data-gear>
        <ChalkShapes shapes={rig.gear(rig.still)} />
      </g>
    )}
  </g>
  <g
    data-body
    class={tone === 'chalk' ? 'text-chalk' : 'text-steel-950'}
    opacity={tone === 'chalk' ? 0.55 : 0.5}
    stroke="currentColor"
    fill="currentColor"
    stroke-width="4"
    stroke-linecap="round"
    stroke-linejoin="round"
    filter={`url(#${filterId})`}
  >
    <ChalkShapes shapes={rig.pose(rig.still)} gapClass={gapClass} body />
  </g>
</svg>

<script>
  import { initAthletes } from '../../lib/athletes';
  initAthletes();
</script>
