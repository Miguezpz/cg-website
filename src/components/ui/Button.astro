---
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

type Variant = 'primary' | 'secondary';
type Size = 'md' | 'sm';

type Props = {
  variant?: Variant;
  size?: Size;
  icon?: IconName;
  class?: string;
} & (
  | ({ href: string } & Omit<HTMLAttributes<'a'>, 'href' | 'class'>)
  | ({ href?: undefined } & Omit<HTMLAttributes<'button'>, 'class'>)
);

const {
  variant = 'primary',
  size = 'md',
  icon,
  class: className,
  href,
  ...rest
} = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-3 text-label font-semibold uppercase transition-[background-color,color,scale] duration-fast ease-out-expo select-none active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50 aria-disabled:cursor-not-allowed aria-disabled:opacity-50';

const variants: Record<Variant, string> = {
  primary:
    'bg-signal text-chalk shadow-glow hover:bg-signal-strong disabled:hover:bg-signal',
  // La tiza «sube» desde abajo al pasar el puntero (llenado con ::before).
  secondary:
    'relative isolate overflow-hidden border-2 border-chalk text-chalk hover:text-steel-950 before:absolute before:inset-0 before:-z-10 before:origin-bottom before:scale-y-0 before:bg-chalk before:transition-[scale] before:duration-200 before:ease-out-expo hover:before:scale-y-100',
};

const sizes: Record<Size, string> = {
  md: 'min-h-[52px] px-6',
  sm: 'min-h-11 px-4',
};

const classes = [base, sizes[size], variants[variant], className];
// En el primario, el ícono «suena» al pasar el puntero.
const iconClass = [
  'size-5 shrink-0',
  variant === 'primary' ? 'group-hover:animate-ring' : '',
].join(' ');
const { type: buttonType = 'button', ...buttonRest } =
  rest as HTMLAttributes<'button'>;
---

{href ? (
  <a href={href} class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
    {icon && <Icon name={icon} class={iconClass} />}
    <slot />
  </a>
) : (
  <button type={buttonType} class:list={classes} {...buttonRest}>
    {icon && <Icon name={icon} class={iconClass} />}
    <slot />
  </button>
)}
