---
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

type Variant = 'primary' | 'secondary';
type Size = 'md' | 'sm';

type Props = {
  variant?: Variant;
  size?: Size;
  icon?: IconName;
  class?: string;
} & (
  | ({ href: string } & Omit<HTMLAttributes<'a'>, 'href' | 'class'>)
  | ({ href?: undefined } & Omit<HTMLAttributes<'button'>, 'class'>)
);

const {
  variant = 'primary',
  size = 'md',
  icon,
  class: className,
  href,
  ...rest
} = Astro.props;

const base =
  'stretch-label inline-flex items-center justify-center gap-3 text-label font-semibold uppercase transition-[background-color,color,scale] duration-fast ease-out-expo select-none active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50 aria-disabled:cursor-not-allowed aria-disabled:opacity-50';

const variants: Record<Variant, string> = {
  primary:
    'bg-signal text-steel-950 hover:bg-signal-strong disabled:hover:bg-signal',
  secondary:
    'border-2 border-chalk text-chalk hover:bg-chalk hover:text-steel-950',
};

const sizes: Record<Size, string> = {
  md: 'min-h-[52px] px-6',
  sm: 'min-h-11 px-4',
};

const classes = [base, sizes[size], variants[variant], className];
const { type: buttonType = 'button', ...buttonRest } =
  rest as HTMLAttributes<'button'>;
---

{href ? (
  <a href={href} class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
    {icon && <Icon name={icon} class="size-5 shrink-0" />}
    <slot />
  </a>
) : (
  <button type={buttonType} class:list={classes} {...buttonRest}>
    {icon && <Icon name={icon} class="size-5 shrink-0" />}
    <slot />
  </button>
)}
