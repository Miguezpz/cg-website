---
// Etiqueta de dato (precio, modalidad). Nunca como «eyebrow» sobre un título.
interface Props {
  tone?: 'steel' | 'signal';
  class?: string;
}
const { tone = 'steel', class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center px-2 py-1 text-label font-semibold uppercase tabular-nums',
    tone === 'signal'
      ? 'bg-signal text-chalk'
      : 'border border-steel-700 text-concrete-400',
    className,
  ]}
>
  <slot />
</span>
