---
import ChalkMark from './ChalkMark.astro';

/** Palabra del título que se marca con gis (círculo o subrayado). */
export interface HeadingMark {
  word: string;
  kind: 'circle' | 'underline' | 'double';
}

interface Props {
  id?: string;
  class?: string;
  title?: string;
  mark?: HeadingMark;
}

const { id, class: className, title, mark } = Astro.props;

const at =
  title && mark ? title.toLowerCase().indexOf(mark.word.toLowerCase()) : -1;
const parts =
  title && mark && at >= 0
    ? [
        title.slice(0, at),
        title.slice(at, at + mark.word.length),
        title.slice(at + mark.word.length),
      ]
    : undefined;

const markClass: Record<HeadingMark['kind'], string> = {
  circle:
    '-top-[0.16em] -left-[0.22em] h-[calc(100%+0.32em)] w-[calc(100%+0.44em)]',
  underline: '-bottom-[0.2em] left-0 h-[0.24em] w-full',
  double: '-bottom-[0.32em] left-0 h-[0.36em] w-full',
};
---

<h2
  id={id}
  class:list={[
    'ledge stretch-display text-h2 font-extrabold uppercase',
    // Espacio para que el subrayado de gis no se encime con lo que sigue.
    mark && mark.kind !== 'circle' && 'pb-[0.3em]',
    className,
  ]}
>
  {parts && mark ? (
    <>
      {parts[0]}
      <span class="relative inline-block">
        {parts[1]}
        <ChalkMark
          variant={mark.kind}
          draw
          class={`pointer-events-none absolute [--chalk-delay:300ms] [--chalk-duration:700ms] ${markClass[mark.kind]}`}
        />
      </span>
      {parts[2]}
    </>
  ) : title ? (
    title
  ) : (
    <slot />
  )}
</h2>
