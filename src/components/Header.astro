---
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import Logo from './ui/Logo.astro';

interface Props {
  brand: string;
  links: readonly { label: string; href: string }[];
  cta: { label: string; href: string };
}

const { brand, links, cta } = Astro.props;
---

<div
  data-header-sentinel
  class="absolute top-0 h-px w-full"
  aria-hidden="true"
></div>
<header
  data-header
  class="sticky top-0 z-40 border-b border-steel-700 bg-steel-950 transition-[background-color,border-color] duration-fast data-at-top:border-transparent data-at-top:bg-transparent data-open:border-steel-700 data-open:bg-steel-950"
>
  <div class="mx-auto flex h-16 w-full max-w-content items-center gap-4 px-gutter">
    <a
      href="#contenido"
      class="mr-auto flex min-h-11 items-center gap-3 text-chalk"
      aria-label={`${brand}, inicio`}
    >
      <Logo class="h-8 w-auto" />
      <span
        class="hidden text-label font-bold tracking-[0.08em] uppercase sm:inline"
        translate="no"
      >
        {brand}
      </span>
    </a>

    <nav aria-label="Principal" class="relative hidden lg:block">
      <ul class="flex items-center gap-1">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link
              class="inline-flex min-h-11 items-center px-3 text-label font-semibold text-concrete-400 uppercase transition-colors duration-fast hover:text-chalk aria-[current=location]:text-chalk"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <span
        data-nav-indicator
        aria-hidden="true"
        class="nav-indicator pointer-events-none absolute bottom-2 left-0 h-0.5 w-px origin-left bg-chalk opacity-0"
      ></span>
    </nav>

    <Button variant="secondary" size="sm" href={cta.href}>
      {cta.label}
    </Button>

    <button
      type="button"
      data-menu-toggle
      hidden
      aria-expanded="false"
      aria-controls="menu-movil"
      aria-label="Abrir menú"
      class="group -mr-2 inline-flex size-11 items-center justify-center text-chalk lg:hidden"
    >
      <Icon name="menu" class="size-6 group-aria-expanded:hidden" />
      <Icon name="close" class="hidden size-6 group-aria-expanded:block" />
    </button>
  </div>

  <div
    id="menu-movil"
    data-menu
    hidden
    class="menu-panel fixed inset-x-0 top-16 bottom-0 overflow-y-auto overscroll-contain bg-steel-950 lg:hidden"
  >
    <nav aria-label="Menú móvil" class="px-gutter pt-6 pb-10">
      <ul class="border-t border-steel-700">
        {links.map((link, i) => (
          <li class="border-b border-steel-700" style={`--i:${i}`}>
            <a
              href={link.href}
              data-menu-link
              class="flex min-h-16 items-center text-h2 font-bold uppercase"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <span
    aria-hidden="true"
    class="scroll-progress pointer-events-none absolute inset-x-0 -bottom-px h-0.5 bg-chalk"
  ></span>
</header>

<style>
  /* Entrada del menú en 200 ms; el cierre es inmediato (salida más rápida). */
  .menu-panel:not([hidden]) {
    transition:
      opacity 200ms var(--ease-out-expo),
      translate 200ms var(--ease-out-expo);
    @starting-style {
      opacity: 0;
      translate: 0 -0.5rem;
    }
  }
  .menu-panel:not([hidden]) li {
    transition: translate 240ms var(--ease-out-expo);
    transition-delay: calc(var(--i, 0) * 40ms);
    @starting-style {
      translate: 0 0.75rem;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const sentinel = document.querySelector('[data-header-sentinel]');
  const toggle =
    document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (header && sentinel) {
    new IntersectionObserver(([entry]) => {
      header.toggleAttribute('data-at-top', entry.isIntersecting);
    }).observe(sentinel);
  }

  // Marca en el menú la sección que está en pantalla y desliza el indicador.
  const navLinks = [
    ...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'),
  ];
  const indicator = document.querySelector<HTMLElement>('[data-nav-indicator]');
  const sections = navLinks
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((el): el is HTMLElement => el !== null);
  let current: HTMLAnchorElement | undefined;
  let indicatorShown = false;

  const placeIndicator = (animate: boolean) => {
    if (!indicator) return;
    if (!current || current.offsetParent === null) {
      indicator.style.opacity = '0';
      indicatorShown = false;
      return;
    }
    // Los enlaces tienen 12 px de padding: la línea va solo bajo el texto.
    const place = () => {
      indicator.style.translate = `${current!.offsetLeft + 12}px 0`;
      indicator.style.scale = `${Math.max(current!.offsetWidth - 24, 0)} 1`;
    };
    if (!animate || !indicatorShown) {
      indicator.style.transition = 'none';
      place();
      void indicator.offsetWidth;
      indicator.style.transition = '';
    } else place();
    indicator.style.opacity = '1';
    indicatorShown = true;
  };

  if (sections.length) {
    const visible = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target);
          else visible.delete(entry.target);
        }
        const section = sections.find((s) => visible.has(s));
        current = navLinks.find((l) => section && l.hash === `#${section.id}`);
        for (const link of navLinks) {
          if (link === current) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
        placeIndicator(true);
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
    if (indicator?.parentElement) {
      new ResizeObserver(() => placeIndicator(false)).observe(
        indicator.parentElement,
      );
    }
  }

  if (header && toggle && menu) {
    toggle.hidden = false;

    const setOpen = (open: boolean, { restoreFocus = true } = {}) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      menu.hidden = !open;
      header.toggleAttribute('data-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) menu.querySelector<HTMLElement>('a')?.focus();
      else if (restoreFocus) toggle.focus();
    };

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    toggle.addEventListener('click', () => setOpen(!isOpen()));
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('[data-menu-link]')) {
        setOpen(false, { restoreFocus: false });
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) setOpen(false);
    });
    matchMedia('(min-width: 64rem)').addEventListener('change', (event) => {
      if (event.matches && isOpen()) setOpen(false, { restoreFocus: false });
    });
  }
</script>
