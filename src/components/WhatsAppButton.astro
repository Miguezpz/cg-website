---
import Icon from './ui/Icon.astro';
import { waAttrs } from '../lib/whatsapp';

interface Props {
  label: string;
}
const { label } = Astro.props;
---

<!-- Móvil: barra a todo el ancho con texto. Escritorio: círculo abajo a la derecha. -->
<a
  {...waAttrs({ source: 'floating' })}
  aria-label={label}
  data-floating-wa
  data-hidden
  class="fixed inset-x-0 bottom-0 z-30 flex min-h-14 items-center justify-center gap-3 bg-whatsapp px-gutter pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] text-label font-semibold text-steel-950 uppercase shadow-[0_-6px_20px_rgb(0_0_0/0.45)] transition-[opacity,translate,scale] duration-200 ease-out-expo active:scale-[0.97] data-hidden:pointer-events-none data-hidden:translate-y-[150%] data-hidden:opacity-0 data-hidden:duration-150 md:inset-x-auto md:right-4 md:bottom-[calc(1rem+env(safe-area-inset-bottom))] md:size-14 md:min-h-0 md:rounded-full md:p-0 md:shadow-[0_6px_20px_rgb(0_0_0/0.45)]"
>
  <Icon name="whatsapp" class="size-6 md:size-7" />
  <span class="md:hidden" aria-hidden="true">
    {label}
  </span>
</a>

<script>
  // Se oculta mientras hay otro CTA general en pantalla (Hero, cierres de
  // Sobre mí y Testimonios) o la sección de contacto, para no duplicarlo.
  const button = document.querySelector<HTMLElement>('[data-floating-wa]');
  const targets = [
    ...document.querySelectorAll(
      'main a[data-track="whatsapp"]:is([data-source="hero"], [data-source="about"], [data-source="testimonials"])',
    ),
    document.querySelector('#contacto'),
  ].filter((el): el is HTMLElement => el instanceof HTMLElement);

  if (button && targets.length) {
    const visible = new Set<Element>();
    let pulsed = false;
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target);
        else visible.delete(entry.target);
      }
      const hide = visible.size > 0;
      button.toggleAttribute('data-hidden', hide);
      button.toggleAttribute('inert', hide);
      // La primera vez que aparece emite dos ondas (motion.css) y se detiene.
      if (!hide && !pulsed) {
        pulsed = true;
        button.toggleAttribute('data-pulse', true);
        setTimeout(() => button.removeAttribute('data-pulse'), 2400);
      }
    });
    targets.forEach((target) => observer.observe(target));
  }
</script>
