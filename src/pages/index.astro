---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import DisciplineTape from '../components/sections/DisciplineTape.astro';
import Services from '../components/sections/Services.astro';
import Results from '../components/sections/Results.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Faq from '../components/sections/Faq.astro';
import Contact from '../components/sections/Contact.astro';
import JsonLd from '../components/JsonLd.astro';
import { getImage } from 'astro:assets';
import { buildStructuredData } from '../lib/structured-data';
import heroImage from '../assets/hero/hollow-back.jpg';
import coachPhoto from '../assets/coach/cesar-augusto.png';
import { site } from '../data/site';
import { services } from '../data/services';
import { results } from '../data/results';
import { testimonials } from '../data/testimonials';
import { faq } from '../data/faq';
import {
  about,
  contact,
  faqSection,
  hero,
  howItWorks,
  resultsSection,
  servicesSection,
  tape,
  testimonialsSection,
} from '../data/home';

const coachImage = await getImage({
  src: coachPhoto,
  format: 'jpg',
  width: 537,
});
const structuredData = buildStructuredData({
  site,
  siteUrl: new URL('/', Astro.site),
  services,
  faq,
  coachImage: coachImage.src,
});
---

<SiteLayout>
  <JsonLd slot="head" data={structuredData} />
  <Hero {...hero} image={heroImage} />
  <DisciplineTape {...tape} />
  <About {...about} photo={coachPhoto} />
  <Services {...servicesSection} services={services} />
  <Results {...resultsSection} results={results} />
  <Testimonials {...testimonialsSection} testimonials={testimonials} />
  <HowItWorks {...howItWorks} />
  <Faq {...faqSection} items={faq} />
  <Contact
    {...contact}
    social={site.social}
    formAction="https://api.web3forms.com/submit"
    accessKey={import.meta.env.PUBLIC_WEB3FORMS_KEY ?? ''}
    redirect={new URL('/gracias/', Astro.site).href}
    subject={`Nuevo contacto desde la web · ${site.name}`}
  />
</SiteLayout>
