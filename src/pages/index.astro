---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Container from '../components/ui/Container.astro';
import Logo from '../components/ui/Logo.astro';
import { site } from '../data/site';
import { waAttrs } from '../lib/whatsapp';
---

<BaseLayout>
  <Container class="py-8">
    <Logo class="h-10 w-auto text-chalk" title={site.name} />
    <h1 class="stretch-display mt-10 text-display font-black uppercase">
      {site.slogan}
    </h1>
    <p class="mt-4 max-w-prose text-lede">{site.tagline}</p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button icon="whatsapp" {...waAttrs({ source: 'hero' })}>
        Clase muestra gratis
      </Button>
      <Button variant="secondary" href="#contenido">
        Ver servicios
      </Button>
    </div>
  </Container>
</BaseLayout>
