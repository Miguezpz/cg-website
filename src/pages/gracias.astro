---
import SiteLayout from '../layouts/SiteLayout.astro';
import Athlete from '../components/ui/Athlete.astro';
import Button from '../components/ui/Button.astro';
import { contact, thanks } from '../data/home';
import { site } from '../data/site';
import { waAttrs } from '../lib/whatsapp';
---

<SiteLayout title={`${thanks.title} · ${site.name}`} noindex>
  <section class="mx-auto grid w-full max-w-content gap-x-12 px-gutter py-section md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
    <div>
      <h1 class="text-display font-bold uppercase">{thanks.title}</h1>
      <p class="mt-5 max-w-prose text-lede">{thanks.text}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button icon="whatsapp" {...waAttrs({ source: 'contact' })}>
          {contact.whatsappCta}
        </Button>
        <Button variant="secondary" href="/">
          {thanks.back}
        </Button>
      </div>
    </div>
    <!-- Festejo: dos pistol squats, una sola vez (la página casi no tiene scroll). -->
    <Athlete
      exercise="pistol"
      once
      class="mt-12 h-40 w-auto justify-self-end md:mt-0 md:h-64"
    />
  </section>
</SiteLayout>
