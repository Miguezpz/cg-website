---
import SiteLayout from '../layouts/SiteLayout.astro';
import Button from '../components/ui/Button.astro';
import { notFound } from '../data/home';
import { site } from '../data/site';
---

<SiteLayout title={`${notFound.title} · ${site.name}`} noindex>
  <section class="mx-auto w-full max-w-content px-gutter py-section">
    <p
      class="text-[clamp(6rem,30vw,12rem)] leading-none font-bold text-concrete-400"
      aria-hidden="true"
    >
      404
    </p>
    <h1 class="mt-4 text-h2 font-bold uppercase">{notFound.title}</h1>
    <p class="mt-4 max-w-prose text-lede">{notFound.text}</p>
    <Button variant="secondary" href="/" class="mt-8">
      {notFound.back}
    </Button>
  </section>
</SiteLayout>
